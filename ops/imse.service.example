[Unit]
Description=Enni IMSE settings API staging service
After=network.target

[Service]
Type=simple
User=enni-imse
Group=enni-imse
WorkingDirectory=%h/apps/imse/current
EnvironmentFile=%h/.config/enni/imse.env
ExecStart=dotnet %h/apps/imse/current/IMSEModern.dll
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=enni-imse
StateDirectoryMode=0700
ReadWritePaths=%S/enni-imse
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
